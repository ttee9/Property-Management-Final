# Database (defaults to a local SQLite file if unset)
DATABASE_URL=sqlite:///./property_management.db

# JWT signing secret - set a long random value in production
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# OTP settings
OTP_TTL_MINUTES=5

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# development | production
# In development, /auth/tenant/request-otp echoes the code in the response
# so you can log in without a real SMS provider configured.
ENVIRONMENT=development

# Optional: Twilio credentials for sending real OTP text messages.
# If left unset, OTP codes are logged to the backend console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
